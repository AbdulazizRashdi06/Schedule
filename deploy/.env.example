# Copy to deploy/.env on the server (/opt/uni-schedule/deploy/.env). Not committed.
ZARQA_NETWORK=zarqa_default
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Uni Schedule <schedule@example.com>
# true shows sign-in codes in the app to anyone who types an ID: only use it while testing.
AUTH_TEST_MODE=false
OWNER_IDS=
# Optional: any server setting, written Section__Key=value (README.md, Configuration). Left out, each keeps
# appsettings.json's value or the code's default, shown here. Remove the # to change one.
# Per IP per 5 minutes (everyone on campus Wi-Fi shares one IP).
# RateLimits__RequestCode=1000
# RateLimits__Verify=2000
# RateLimits__PublicTimetable=600
# Wrong sign-in codes per IP per rolling hour, across all IDs.
# RateLimits__WrongCodesPerHour=300
# Teachers (staff emails). Code requests per IP per 5 minutes: each one sends mail to a staff mailbox.
# RateLimits__TeacherRequestCode=60
# Wrong teacher codes per IP per rolling hour, from browsers that address hasn't signed in on.
# RateLimits__TeacherWrongCodesPerHour=30
# Wrong teacher codes per rolling hour, site-wide, for addresses with no account yet. Reaching it pauses first-time
# teacher sign-ins until the count falls; the dashboard home shows until when.
# RateLimits__TeacherWrongCodesNewPerHour=40
# Extra EduWave course codes Classy Sync fetches, comma-separated. Empty means none.
# Sync__ExtraCodes=CS1102-L
# The owners' dashboard setting wins over this.
# Planner__Enabled=false
# Planner__AiUrl=http://codex:8090/v1/chat/completions
# Planner__AiModel=gpt-6-luna
# Analytics__Enabled=true
# Push__Subject=mailto:schedule@tryzarqa.com
